{
  "$schema": "../gen/schemas/android-schema.json",
  "identifier": "android",
  "description": "Minimal capability set for the Android mobile interface",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "allow-android-platform-status",
    "allow-mobile-storage-ensure",
    "allow-mobile-storage-list",
    "allow-mobile-storage-read",
    "allow-mobile-storage-save",
    "allow-mobile-storage-trash",
    "allow-mobile-storage-restore",
    "allow-mobile-storage-delete",
    "allow-syncthing-scan-folder",
    "allow-android-scan-device-qr",
    "allow-android-get-background-policy",
    "allow-android-set-background-policy",
    "allow-android-request-notification-permission",
    "allow-android-request-local-network-permission",
    "allow-android-open-battery-settings",
    "allow-syncthing-status",
    "allow-syncthing-start",
    "allow-syncthing-stop",
    "allow-syncthing-pairing-info",
    "allow-syncthing-preview-device-pairing",
    "allow-syncthing-confirm-device-pairing"
  ]
}
