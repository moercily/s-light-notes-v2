{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "s-light notes",
  "version": "2.0.0-alpha.0",
  "identifier": "com.slightnotes.v2",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "s-light notes",
        "width": 1180,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "../app/icons/icon-192.png",
      "../app/icons/icon-512.png"
    ]
  }
}
