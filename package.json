{
  "name": "s-light-notes",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/structure.test.mjs && node tests/desktop-service.test.mjs && node tests/mobile-storage-service.test.mjs && node tests/android-sync-service.test.mjs && node tests/desktop-storage.test.mjs && node tests/sync-service.test.mjs && node tests/sync-center.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:macos-intel": "tauri build --target x86_64-apple-darwin --bundles app",
    "tauri:build:windows": "tauri build --bundles nsis",
    "tauri:build:linux": "tauri build --bundles deb,appimage",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "android:signing:setup": "node scripts/setup-android-signing.mjs",
    "tauri:android:build:release": "npm run tauri:android:build:release:apk && npm run tauri:android:build:release:aab",
    "tauri:android:build:release:apk": "tauri android build --target aarch64 x86_64 --split-per-abi --apk --ci",
    "tauri:android:build:release:aab": "tauri android build --target aarch64 x86_64 --aab --ci",
    "android:release:collect": "node scripts/package-android-release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
